# ── Node.js (development tests: no npm dependencies required) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# ── Python (local server) ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# ── Browser Pyodide runtime cache (never in the repo) ──
.pyodide/
pyodide-lock.json

# ── Build artifacts and archives ──
dist/
build/
*.zip
*.tar.gz

# ── Environment variables and secrets ──
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# ── Operating system ──
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Editors and IDEs ──
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# ── Log ──
*.log
logs/

# ── Test browsers / coverage ──
coverage/
.nyc_output/
test-results/
playwright-report/
